{
  "name": "frame-annotator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "electron": "electron .",
    "electron:build": "node scripts/build-electron.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "mediabunny": "^1.58.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "8.0.13",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "dev.frameannotator.app",
    "productName": "Frame Annotator",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
